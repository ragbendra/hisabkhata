# Copy to .env (all variables are prefixed FK_)
FK_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/fruitkhata
FK_COOKIE_SECURE=true
FK_APP_BASE_URL=https://khata.example.com

# Email (password reset, weekly Excel copy, backup warnings). Without FK_SMTP_HOST, emails are only logged.
FK_SMTP_HOST=smtp.example.com
FK_SMTP_PORT=587
FK_SMTP_USER=
FK_SMTP_PASSWORD=
FK_SMTP_FROM=Hisab <no-reply@example.com>

# Backups
FK_BACKUP_DIR=/var/backups/fruit-khata
# Off-site copy at a DIFFERENT provider (any S3-compatible storage). Leave empty to skip.
FK_OFFSITE_BUCKET=
FK_OFFSITE_ENDPOINT_URL=
FK_OFFSITE_ACCESS_KEY=
FK_OFFSITE_SECRET_KEY=

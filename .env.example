# Template of the environment variables Hisab reads. All app settings start with FK_.
# Locally: copy to .env (it is gitignored). On Render: set these in the service's Environment tab.
# Never commit real values.

# --- Database (required) ---
# Neon connection string. Use the postgresql+psycopg2:// form and keep ?sslmode=require
FK_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- App (required in production) ---
# Public URL of the site, used in password-reset links
FK_APP_BASE_URL=https://your-app.onrender.com
# true when served over HTTPS (it always is on Render); false only for local http
FK_COOKIE_SECURE=true
# Where the built frontend lives inside the image (set in render.yaml)
FK_STATIC_DIR=/app/frontend/dist
# Number of server workers. Use 1 on Render's free 512 MB plan if the app runs out of memory
WEB_CONCURRENCY=2

# --- Email (optional) ---
# Needed for password reset and the weekly Excel email. Without FK_SMTP_HOST, emails are only logged.
FK_SMTP_HOST=
FK_SMTP_PORT=587
FK_SMTP_USER=
FK_SMTP_PASSWORD=
FK_SMTP_FROM=Hisab <no-reply@example.com>

# --- Off-site backups (optional) ---
# Only used by the backup job, which needs a scheduler. Render's free plan has none.
FK_OFFSITE_BUCKET=
FK_OFFSITE_ENDPOINT_URL=
FK_OFFSITE_ACCESS_KEY=
FK_OFFSITE_SECRET_KEY=